{
  "name": "@tradejs/strategies",
  "version": "1.0.9",
  "description": "Built-in strategy plugin catalog for the TradeJS open-source framework.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "strategies",
    "plugin",
    "algorithmic-trading"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradejs-dev/tradejs.git",
    "directory": "packages/strategies"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tradejs/core": "workspace:^",
    "@tradejs/indicators": "workspace:^",
    "@tradejs/node": "workspace:^",
    "@tradejs/types": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
