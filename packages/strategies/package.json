{
  "name": "@tradejs/strategies",
  "version": "1.0.2",
  "description": "Built-in TradeJS strategy plugin catalog.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "strategies",
    "plugin",
    "algorithmic-trading"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tradejs/core": "workspace:^",
    "@tradejs/indicators": "workspace:^",
    "@tradejs/node": "workspace:^",
    "@tradejs/types": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
