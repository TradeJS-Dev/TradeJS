{
  "name": "@tradejs/infra",
  "version": "3.1.4",
  "description": "MIT-licensed server infrastructure adapters for TradeJS: Redis, Timescale, ML, logging, and IO.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "infrastructure",
    "redis",
    "timescale",
    "ml",
    "ai",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS",
    "directory": "packages/infra"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "files": [
    "dist",
    "proto"
  ],
  "exports": {
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.js"
    },
    "./backtestArtifacts": {
