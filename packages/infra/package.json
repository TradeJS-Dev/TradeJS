{
  "name": "@tradejs/infra",
  "version": "1.0.7",
  "description": "Server-only infrastructure adapters for the TradeJS open-source framework: Redis, Timescale, ML, logging, and IO.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "infrastructure",
    "redis",
    "timescale",
    "ml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradejs-dev/tradejs.git",
    "directory": "packages/infra"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "files": [
    "dist",
    "proto"
  ],
  "exports": {
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.js"
    },
    "./aiEndpoints": {
      "types": "./dist/aiEndpoints.d.ts",
      "import": "./dist/aiEndpoints.mjs",
      "require": "./dist/aiEndpoints.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.mjs",
      "require": "./dist/files.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "require": "./dist/http.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.mjs",
      "require": "./dist/logger.js"
    },
    "./ml": {
      "types": "./dist/ml.d.ts",
      "import": "./dist/ml.mjs",
      "require": "./dist/ml.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.mjs",
      "require": "./dist/redis.js"
    },
    "./userSettings": {
      "types": "./dist/userSettings.d.ts",
      "import": "./dist/userSettings.mjs",
      "require": "./dist/userSettings.js"
    },
    "./timescale": {
      "types": "./dist/timescale.d.ts",
      "import": "./dist/timescale.mjs",
      "require": "./dist/timescale.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.7",
    "@grpc/proto-loader": "^0.8.0",
    "@tradejs/types": "workspace:^",
    "chalk": "4.1.2",
    "ioredis": "5.8.0",
    "pg": "8.16.3",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
