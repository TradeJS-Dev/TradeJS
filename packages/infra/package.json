  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@tradejs/types": "workspace:^",
    "chalk": "4.1.2",
    "date-fns": "^3.6.0",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
