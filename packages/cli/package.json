{
  "name": "@tradejs/cli",
  "version": "3.1.0",
  "description": "Official CLI for the TradeJS TypeScript framework: infra setup, backtests, signals, bots, and ML workflows.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "cli",
    "signals",
    "bot",
    "automation"
  ],
  "homepage": "https://tradejs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "tradejs": "dist/cli.js"
  },
  "dependencies": {
    "@tradejs/connectors": "workspace:^",
    "@tradejs/core": "workspace:^",
    "@tradejs/indicators": "workspace:^",
    "@tradejs/infra": "workspace:^",
    "@tradejs/node": "workspace:^",
    "@tradejs/strategy-kit": "^3.0.0",
    "@tradejs/types": "workspace:^",
    "args": "^5.0.3",
    "bcryptjs": "^2.4.3",
    "chalk": "4.1.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "ioredis": "5.11.1",
    "list-it": "^1.3.13",
    "lodash": "^4.18.1",
    "pg": "8.22.0",
    "progress": "^2.0.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9"
  },
  "scripts": {
    "agent-run": "yarn run run:dist agent-run",
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "run:src": "dotenv -e \"${DOTENV_CONFIG_PATH:-${PROJECT_CWD:-$PWD}/.env}\" -- ts-node -r tsconfig-paths/register",
    "run:dist": "dotenv -e \"${DOTENV_CONFIG_PATH:-${PROJECT_CWD:-$PWD}/.env}\" -- node ./dist/cli.js",
    "clean-dir": "yarn run run:dist clean-dir",
    "clean-redis": "yarn run run:dist clean-redis",
    "clean-tests": "yarn run run:dist clean-tests",
    "doctor": "yarn run run:dist doctor",
    "ai-export": "yarn run run:dist ai-export",
    "ai-pocket-search": "yarn run run:dist ai-pocket-search",
    "ai-train": "yarn run run:dist ai-train",
    "backtest": "yarn run run:dist backtest",
    "breadth:universes:update": "yarn run run:dist binance:breadth-universes:update",
    "bot": "yarn run run:dist bot",
    "candles:migrate-provider": "yarn run run:dist candles:migrate-provider",
    "signals": "yarn run run:dist signals",
    "results": "yarn run run:dist results",
    "replay-runtime-evidence": "yarn run run:dist replay-runtime-evidence",
    "runtime-evidence": "yarn run run:dist runtime-evidence",
    "runtime-evidence-sync": "yarn run run:dist runtime-evidence-sync",
    "runtime-scorecard": "yarn run run:dist runtime-scorecard",
    "strategy-release": "yarn run run:dist strategy-release",
    "continuity": "yarn run run:dist continuity",
    "derivatives:ingest": "yarn run run:dist derivatives:ingest",
    "derivatives:ingest:coinalyze:all": "yarn run run:dist derivatives:ingest:coinalyze:all",
    "infra-init": "yarn run run:dist infra-init",
    "infra-up": "yarn run run:dist infra-up",
    "market-ws": "yarn run run:dist market-ws",
    "hyperliquid:whale-backfill": "yarn run run:dist hyperliquid:whale-backfill",
    "hyperliquid:whale-ingest": "yarn run run:dist hyperliquid:whale-ingest",
    "hyperliquid:whales:update": "yarn run run:dist hyperliquid:whales:update",
    "infra-down": "yarn run run:dist infra-down",
    "spread:ingest": "yarn run run:dist spread:ingest",
    "migration": "yarn run run:dist migration",
    "ml-export": "yarn run run:dist ml-export",
    "ml-inspect": "yarn run run:dist ml-inspect",
    "ml-train:latest": "yarn run run:dist ml-train:latest",
    "research:auto": "yarn run run:dist research:auto",
    "research:core": "yarn run run:dist research:core",
    "ml-train:trendline:catboost": "yarn run run:dist ml-train:trendline:catboost",
    "ml-train:trendline:extra-trees": "yarn run run:dist ml-train:trendline:extra-trees",
    "ml-train:trendline:lightgbm": "yarn run run:dist ml-train:trendline:lightgbm",
    "ml-train:trendline:rf": "yarn run run:dist ml-train:trendline:rf",
    "ml-train:trendline:xgboost": "yarn run run:dist ml-train:trendline:xgboost",
    "ml-train:unified:catboost": "yarn run run:dist ml-train:unified:catboost",
    "runtime-parity": "yarn run run:dist runtime-parity",
    "test-script": "yarn run run:dist test-script",
    "test-ml": "yarn run run:dist test-ml",
    "user-add": "yarn run run:dist user-add"
  },
  "license": "BUSL-1.1",
  "author": "aleksnick (https://github.com/aleksnick)"
}
