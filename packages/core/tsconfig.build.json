{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "paths": {
      "@tradejs/types": ["./packages/types/src/index"],
      "@tradejs/types/*": ["./packages/types/src/*"],
      "@constants": ["./packages/core/src/constants/index"],
      "@utils/*": ["./packages/core/src/utils/*"]
    },
    "incremental": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
