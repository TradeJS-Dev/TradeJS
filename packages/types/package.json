{
  "name": "@tradejs/types",
  "version": "3.1.11",
  "description": "MIT-licensed shared TypeScript contracts for the TradeJS framework.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "typescript",
    "types",
    "contracts",
    "ai",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
