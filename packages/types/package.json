{
  "name": "@tradejs/types",
  "version": "1.0.0",
  "description": "Shared TypeScript contracts for the TradeJS ecosystem.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "typescript",
    "types",
    "contracts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
