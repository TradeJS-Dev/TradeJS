{
  "name": "@tradejs/native",
  "version": "1.0.0",
  "private": true,
  "description": "Native Rust accelerators for TradeJS runtime experiments.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "tradejs-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "2.18.4",
    "typescript": "^5.1"
  },
  "license": "MIT"
}
