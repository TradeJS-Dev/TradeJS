{
  "name": "@tradejs/indicators",
  "version": "3.1.11",
  "description": "MIT-licensed indicator plugin catalog for the TradeJS framework.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "indicators",
    "plugin",
    "technical-analysis",
    "crypto",
    "bybit",
    "binance",
    "coinbase",
    "ai",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS",
    "directory": "packages/indicators"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./range-geometry": {
      "types": "./dist/range-geometry.d.ts",
      "import": "./dist/range-geometry.mjs",
      "require": "./dist/range-geometry.js"
    }
  },
  "dependencies": {
    "@tradejs/core": "workspace:^",
    "@tradejs/types": "workspace:^",
    "fast-technical-indicators": "^1.1.4",
    "klinecharts": "10.0.0-alpha9",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
