{
  "name": "@tradejs/connectors",
  "version": "1.0.4",
  "description": "Built-in TradeJS exchange connectors and market data providers.",
  "keywords": [
    "tradejs",
    "trading",
    "backtesting",
    "connectors",
    "exchange",
    "market-data",
    "bybit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradejs-dev/tradejs.git",
    "directory": "packages/connectors"
  },
  "bugs": {
    "url": "https://github.com/tradejs-dev/tradejs/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tradejs/core": "workspace:^",
    "@tradejs/infra": "workspace:^",
    "@tradejs/node": "workspace:^",
    "@tradejs/types": "workspace:^",
    "bybit-api": "^3.9.0",
    "chalk": "4.1.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)"
}
