{
  "name": "tradejs",
  "version": "2.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "author": "aleksnick (https://github.com/aleksnick)",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent-run": "yarn cli:node8g agent-run",
    "ai-export": "yarn cli:node8g ai-export",
    "ai-pocket-search": "yarn cli:node8g ai-pocket-search",
    "ai-train": "yarn cli:node8g ai-train",
    "backtest": "yarn cli:backtest backtest",
    "bot": "yarn cli:node8g bot",
    "bot:cron": "yarn cli:node8g bot",
    "build": "turbo run build",
    "build:ci": "bash -lc 'rm -rf .turbo apps/*/.next apps/*/build apps/*/.turbo packages/*/dist packages/*/build packages/*/.turbo && yarn build'",
    "candles:migrate-provider": "yarn cli:node8g candles:migrate-provider",
    "bump:packages": "node ./bin/bump-publishable-versions.mjs",
    "checks": "yarn prettify && yarn build && yarn lint && yarn typecheck && yarn unit",
    "clean-ai-export": "yarn clean-dir --dir ai/export",
    "clean-dir": "yarn cli:node8g clean-dir",
    "clean-ml-export": "yarn clean-dir --dir ml/export",
    "clean-redis": "yarn cli:node8g clean-redis",
    "clean-tests": "yarn cli:node8g clean-tests",
    "clean-up": "yarn clean-tests && yarn clean-ml-export",
    "cli": "PROJECT_CWD=\"$PWD\" DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-$PWD/.env}\" time bash ./bin/run-cli-dist.sh",
    "cli:backtest": "PROJECT_CWD=\"$PWD\" DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-$PWD/.env}\" NODE_OPTIONS=\"--max-old-space-size=${BACKTEST_PARENT_HEAP_MB:-1536}\" time bash ./bin/run-cli-dist.sh",
    "cli:replay": "PROJECT_CWD=\"$PWD\" DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-$PWD/.env}\" NODE_OPTIONS=\"--max-old-space-size=${REPLAY_PARENT_HEAP_MB:-12288}\" time bash ./bin/run-cli-dist.sh",
    "cli:node8g": "PROJECT_CWD=\"$PWD\" DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-$PWD/.env}\" NODE_OPTIONS=\"--max-old-space-size=${CLI_PARENT_HEAP_MB:-16384}\" time bash ./bin/run-cli-dist.sh",
    "continuity": "yarn cli:node8g continuity",
    "derivatives:ingest": "yarn cli:node8g derivatives:ingest --provider coinalyze",
    "derivatives:ingest:coinalyze:all": "yarn cli:node8g derivatives:ingest:coinalyze:all",
    "dev": "PROJECT_CWD=\"$PWD\" turbo run dev --filter=@tradejs/app",
    "dev:sandbox": "yarn dev",
    "dev:with-infra": "yarn infra-up && yarn dev",
    "doctor": "yarn cli:node8g doctor",
    "infra-down": "yarn cli:node8g infra-down",
    "infra-init": "yarn cli:node8g infra-init",
    "infra-up": "yarn cli:node8g infra-up",
    "lint": "turbo run lint",
    "migration": "yarn cli:node8g migration",
    "market:ws": "yarn cli:node8g market-ws",
    "ml-build": "docker compose -f docker-compose.ml.yml build",
    "ml-build:profile": "docker compose -f docker-compose.ml.yml build ml-profile",
    "ml-export": "yarn cli:node8g ml-export",
    "ml-infer-build": "docker compose -f docker-compose.infer.yml build",
    "ml-infer-down": "docker compose -f docker-compose.infer.yml down",
    "ml-infer-up": "docker compose -f docker-compose.infer.yml up",
    "ml-inspect": "yarn cli:node8g ml-inspect",
    "ml-train": "bash ./bin/ml-train-with-redis.sh docker compose -f docker-compose.ml.yml run --rm ml",
    "ml-train:2-30-15": "ML_TRAIN_RECENT_DAYS=30 ML_TRAIN_TEST_DAYS=15 ML_TRAIN_WALK_FORWARD_FOLDS=2 ML_TRAIN_ENSEMBLE=1 ML_TRAIN_ENSEMBLE_MEMBERS=2 yarn ml-train:trendline:xgboost",
    "ml-train:2-45-15": "ML_TRAIN_RECENT_DAYS=45 ML_TRAIN_TEST_DAYS=15 ML_TRAIN_WALK_FORWARD_FOLDS=2 ML_TRAIN_ENSEMBLE=1 ML_TRAIN_ENSEMBLE_MEMBERS=2 yarn ml-train:trendline:xgboost",
    "ml-train:2-60-30": "ML_TRAIN_RECENT_DAYS=60 ML_TRAIN_TEST_DAYS=30 ML_TRAIN_WALK_FORWARD_FOLDS=2 ML_TRAIN_ENSEMBLE=1 ML_TRAIN_ENSEMBLE_MEMBERS=2 yarn ml-train:trendline:xgboost",
    "ml-train:cli": "time bash ./bin/ml-train-with-redis.sh yarn cli:node8g",
    "ml-train:latest": "yarn ml-train:cli ml-train:latest",
    "ml-train:trendline:catboost": "yarn ml-train:cli ml-train:trendline:catboost",
    "ml-train:trendline:extra-trees": "yarn ml-train:cli ml-train:trendline:extra-trees",
    "ml-train:trendline:lightgbm": "yarn ml-train:cli ml-train:trendline:lightgbm",
    "ml-train:trendline:rf": "yarn ml-train:cli ml-train:trendline:rf",
    "ml-train:trendline:xgboost": "yarn ml-train:cli ml-train:trendline:xgboost",
    "ml-train:unified:catboost": "yarn ml-train:cli ml-train:unified:catboost",
    "ml-upload:prod": "bash ./bin/upload-models.sh",
    "npm:publish:all": "yarn npm:publish:types && yarn npm:publish:infra && yarn npm:publish:core && yarn npm:publish:node && yarn npm:publish:indicators && yarn npm:publish:strategies && yarn npm:publish:connectors && yarn npm:publish:base && yarn npm:publish:cli && yarn npm:publish:app && yarn npm:publish:create-tradejs",
    "npm:publish:all:dry": "yarn npm:publish:types:dry && yarn npm:publish:infra:dry && yarn npm:publish:core:dry && yarn npm:publish:node:dry && yarn npm:publish:indicators:dry && yarn npm:publish:strategies:dry && yarn npm:publish:connectors:dry && yarn npm:publish:base:dry && yarn npm:publish:cli:dry && yarn npm:publish:app:dry && yarn npm:publish:create-tradejs:dry",
    "npm:publish:app": "yarn workspace @tradejs/app npm publish --access public --tolerate-republish",
    "npm:publish:app:dry": "yarn workspace @tradejs/app npm publish --access public --dry-run",
    "npm:publish:base": "yarn workspace @tradejs/base npm publish --access public --tolerate-republish",
    "npm:publish:base:dry": "yarn workspace @tradejs/base npm publish --access public --dry-run",
    "npm:publish:cli": "yarn workspace @tradejs/cli npm publish --access public --tolerate-republish",
    "npm:publish:cli:dry": "yarn workspace @tradejs/cli npm publish --access public --dry-run",
    "npm:publish:connectors": "yarn workspace @tradejs/connectors npm publish --access public --tolerate-republish",
    "npm:publish:connectors:dry": "yarn workspace @tradejs/connectors npm publish --access public --dry-run",
    "npm:publish:create-tradejs": "yarn workspace create-tradejs npm publish --access public --tolerate-republish",
    "npm:publish:create-tradejs:dry": "yarn workspace create-tradejs npm publish --access public --dry-run",
    "npm:publish:core": "yarn workspace @tradejs/core npm publish --access public --tolerate-republish",
    "npm:publish:core:dry": "yarn workspace @tradejs/core npm publish --access public --dry-run",
    "npm:publish:indicators": "yarn workspace @tradejs/indicators npm publish --access public --tolerate-republish",
    "npm:publish:indicators:dry": "yarn workspace @tradejs/indicators npm publish --access public --dry-run",
    "npm:publish:infra": "yarn workspace @tradejs/infra npm publish --access public --tolerate-republish",
    "npm:publish:infra:dry": "yarn workspace @tradejs/infra npm publish --access public --dry-run",
    "npm:publish:node": "yarn workspace @tradejs/node npm publish --access public --tolerate-republish",
    "npm:publish:node:dry": "yarn workspace @tradejs/node npm publish --access public --dry-run",
    "npm:publish:strategies": "yarn workspace @tradejs/strategies npm publish --access public --tolerate-republish",
    "npm:publish:strategies:dry": "yarn workspace @tradejs/strategies npm publish --access public --dry-run",
    "npm:publish:types": "yarn workspace @tradejs/types npm publish --access public --tolerate-republish",
    "npm:publish:types:dry": "yarn workspace @tradejs/types npm publish --access public --dry-run",
    "npm:whoami": "yarn npm whoami",
    "prettify": "yarn prettier -c -w ./apps ./packages ./examples",
    "publish:packages": "bash ./bin/publish-packages.sh",
    "publish:packages:dry": "bash ./bin/publish-packages.sh --dry-run",
    "quickstart:e2e": "bash ./bin/quickstart-e2e.sh",
    "redis-down": "docker compose -f docker-compose.dev.yml stop redis",
    "redis-restart": "yarn redis-down && yarn redis-up",
    "redis-up": "docker compose -f docker-compose.dev.yml up -d redis",
    "research:auto": "PROJECT_CWD=\"$PWD\" DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-$PWD/.env}\" NODE_OPTIONS=\"--max-old-space-size=${RESEARCH_AUTO_PARENT_HEAP_MB:-1024}\" time bash ./bin/run-cli-dist.sh research:auto",
    "results": "yarn cli:node8g results",
    "server-health": "yarn cli:node8g server-health",
    "runtime-parity": "yarn cli:node8g runtime-parity",
    "sandbox:e2e": "cd examples/sandbox && yarn e2e",
    "sandbox:infra-down": "cd examples/sandbox && yarn infra-down",
    "sandbox:infra-up": "cd examples/sandbox && yarn infra-up",
    "sandbox:install": "cd examples/sandbox && PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_CHROME_SKIP_DOWNLOAD=true yarn install --immutable",
    "sandbox:install:update": "cd examples/sandbox && PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_CHROME_SKIP_DOWNLOAD=true yarn install --no-immutable",
    "sandbox:refresh": "cd examples/sandbox && yarn up -R @tradejs/cli @tradejs/core @tradejs/types @tradejs/base @tradejs/connectors @tradejs/indicators @tradejs/infra @tradejs/node @tradejs/strategies && yarn install",
    "signals": "yarn cli:node8g signals",
    "signals:daemon": "yarn cli:node8g signals-daemon",
    "replay": "yarn cli:replay replay",
    "replay:evidence": "yarn cli:node8g replay-runtime-evidence",
    "runtime:evidence": "yarn cli:node8g runtime-evidence",
    "signals:cron": "yarn cli:node8g signals",
    "signals:summary": "yarn cli:node8g signals-summary",
    "signals:sandbox": "yarn signals",
    "spread:ingest": "yarn cli:node8g spread:ingest",
    "start": "PROJECT_CWD=\"$PWD\" yarn workspace @tradejs/app start",
    "test": "yarn cli:node8g test-script",
    "test-ml": "yarn cli:node8g test-ml",
    "typecheck": "turbo run typecheck",
    "unit": "jest",
    "unit:coverage": "jest --coverage",
    "update-history": "yarn backtest --updateOnly",
    "user-add": "yarn cli:node8g user-add"
  },
  "dependencies": {
    "@tradejs/base": "workspace:^",
    "@tradejs/core": "workspace:^",
    "@tradejs/infra": "workspace:^"
  },
  "resolutions": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "micromatch": "4.0.8",
    "minimatch@npm:3.1.2": "3.1.4",
    "minimatch@npm:9.0.3": "9.0.7",
    "picomatch@npm:^2.3.1": "2.3.2",
    "picomatch@npm:^4.0.0": "4.0.4",
    "postcss": "8.5.12",
    "protobufjs@npm:^7.5.3": "7.5.5",
    "socks-proxy-agent@npm:^8.0.1": "8.0.5",
    "webpack@npm:^5.4.0": "5.94.0",
    "ws@npm:^7.3.1": "7.5.10",
    "ws@npm:^7.4.0": "7.5.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/args": "^5",
    "@types/bcryptjs": "^2.4.6",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4",
    "@types/node": "^24",
    "@types/pg": "8.15.5",
    "@types/progress": "^2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-window": "^1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.0.1",
    "babel-jest": "30.0.0-beta.3",
    "dotenv": "^16.4.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "list-it": "^1.3.12",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "progress": "^2.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "turbo": "^2.9.14",
    "typescript": "^5.1"
  },
  "packageManager": "yarn@4.13.0"
}
