{
  "name": "bb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backtest": "NODE_OPTIONS=\"--max-old-space-size=8192\" time yarn ts-node ./src/scripts/backtest",
    "bot": "time yarn ts-node ./src/scripts/bot",
    "build": "next build",
    "clean-cache": "rimraf ./data/cache/*.json",
    "clean-tests": "rimraf ./data/tests/*.json",
    "dev": "next dev",
    "dev-tsc": "npx tsc --noEmit",
    "docker-build": "docker compose build",
    "docker-run": "docker compose up -d",
    "docker-stop": "docker compose down",
    "lint": "next lint",
    "prettify": "yarn prettier -c -w ./src",
    "start": "next start -H 0.0.0.0",
    "test": "time yarn ts-node ./src/scripts/test",
    "unit": "jest",
    "update-cache": "time yarn ts-node ./src/scripts/update"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.16.1",
    "@ef-carbon/tspm": "^2.2.5",
    "@emotion/react": "^11.14.0",
    "bybit-api": "^3.9.0",
    "chalk": "4.1.2",
    "date-fns": "^3.3.1",
    "klinecharts": "10.0.0-alpha5",
    "lodash": "^4.17.21",
    "next": "14.1.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "recoil": "^0.7.7",
    "technicalindicators": "^3.1.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "11.1.0",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4",
    "@types/node": "^20",
    "@types/progress": "^2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/testing-library__jest-dom": "^6.0.0",
    "autoprefixer": "^10.0.1",
    "babel-jest": "30.0.0-beta.3",
    "dotenv": "^16.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "list-it": "^1.3.12",
    "postcss": "^8",
    "progress": "^2.0.3",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.1.0"
