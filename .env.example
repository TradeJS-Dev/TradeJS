ML_TRAIN_RECENT_DAYS=60
ML_TRAIN_TEST_DAYS=30
ML_TRAIN_WALK_FORWARD_FOLDS=2
ML_TRAIN_FEATURE_PROFILE=all # robust
ML_TRAIN_FEATURE_SET=legacy # enriched
ML_TRAIN_ENSEMBLE=1
