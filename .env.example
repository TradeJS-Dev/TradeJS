HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Optional override for market data preload concurrency.
# Defaults to 1 in production and 10 otherwise.
# KLINE_CONCURRENCY_LIMIT=1
NEXTAUTH_SECRET=string
NEXTAUTH_URL=http://localhost:3000

SSH_HOST=92.63.100.27
SSH_USER=root

NPM_TOKEN=string

REDIS_HOST=redis
REDIS_PORT=6379
ML_GRPC_ADDRESS=ml-infer:50051

PG_HOST=timescale
PG_PORT=5432
PG_USER=app
PG_PASSWORD=app
PG_DATABASE=app

PGADMIN_EMAIL=admin@example.com
