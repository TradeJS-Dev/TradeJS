FROM node:20-alpine

LABEL org.opencontainers.image.source="https://github.com/TradeJS-Dev/TradeJS" \
      org.opencontainers.image.description="TradeJS research and automation agent" \
      org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache \
    bash \
    git \
    openssh-client \
    tzdata \
    cronie \
    ca-certificates

WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml turbo.json tsconfig.json tsconfig.base.json tsconfig.packages.json tradejs.config.ts ./
COPY .yarn ./.yarn
COPY apps/app/package.json ./apps/app/package.json

RUN corepack enable
RUN corepack prepare yarn@4.13.0 --activate

COPY packages ./packages
COPY proto ./proto
COPY bin ./bin
COPY entrypoint.agent.sh ./entrypoint.agent.sh
COPY cronjob.agent ./cronjob.agent

RUN yarn install --immutable
RUN yarn turbo run build --filter=@tradejs/cli...

RUN chmod +x ./entrypoint.agent.sh ./bin/*.sh

CMD ["./entrypoint.agent.sh"]
