worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    client_max_body_size 10m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    server {
        listen 80;
        server_name aleksnick01inv.fvds.ru;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name aleksnick01inv.fvds.ru;

        ssl_certificate /etc/letsencrypt/live/aleksnick01inv.fvds.ru/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/aleksnick01inv.fvds.ru/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        if ($request_uri ~* "(think\\\\app\\\\invokefunction|call_user_func_array|pearcmd|md5|<\?php|<\?echo|\.\./\.\./|phpunit|eval-stdin|autodiscover|wp-login|xmlrpc|\.env|\.git|composer\.json|passwd)") {
            return 403;
        }

        location / {
            proxy_pass http://app:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        }

        location ~ \.php$ {
            return 403;
        }
    }
}
