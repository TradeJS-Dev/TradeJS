{
  "schema": "tradejs-github-environment-migration/v1",
  "containsSecretValues": false,
  "repositories": [
    {
      "repository": "TradeJS",
      "credentials": [
        {
          "name": "NPM_TOKEN",
          "kind": "secret",
          "currentPurpose": "publish synchronized workspace packages",
          "action": "replace-or-rescope",
          "targets": [
            "TradeJS",
            "TradeJS-Strategy-Kit",
            "TradeJS-Strategy-*",
            "TradeJS-Base"
          ],
          "constraint": "Publishing credentials must not be used by TradeJS-Project to install private packages."
        },
        {
          "name": "RELEASE_DEPLOY_KEY",
          "kind": "secret",
          "currentPurpose": "push synchronized release commits",
          "action": "eliminate-if-built-in-repository-token-is-sufficient",
          "targets": []
        },
        {
          "name": "GITHUB_TOKEN",
          "kind": "built-in",
          "currentPurpose": "publish GHCR images",
          "action": "do-not-migrate",
          "targets": []
        }
      ]
    },
    {
      "repository": "TradeJS-Deploy",
      "credentials": [
        {
          "name": "SSH_HOST",
          "kind": "secret",
          "currentPurpose": "production server connection",
          "action": "keep-in-production-environment",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "SSH_USER",
          "kind": "secret",
          "currentPurpose": "production server connection",
          "action": "keep-in-production-environment",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "SSH_KEY",
          "kind": "secret",
          "currentPurpose": "production server connection",
          "action": "keep-and-rotate-after-cutover",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "NEXTAUTH_SECRET",
          "kind": "secret",
          "currentPurpose": "production application authentication",
          "action": "keep-in-production-environment",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "REDISINSIGHT_HTPASSWD",
          "kind": "secret",
          "currentPurpose": "RedisInsight reverse-proxy authentication",
          "action": "keep-in-production-environment",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "AGENT_GITHUB_TOKEN",
          "kind": "secret",
          "currentPurpose": "research agent branch and pull-request access",
          "action": "replace-with-least-privilege-multi-repository-credential",
          "targets": ["TradeJS-Deploy"]
        },
        {
          "name": "GIT_SSH_PRIVATE_KEY",
          "kind": "secret",
          "currentPurpose": "clone the TradeJS repository for the research agent",
          "action": "eliminate-after-strategy-repository-routing",
          "targets": []
        }
      ]
    },
    {
      "repository": "TradeJS-Docs",
      "credentials": [
        {
          "name": "GHCR_USERNAME",
          "kind": "secret",
          "currentPurpose": "optional GHCR login override",
          "action": "keep-unless-docs-publishing-is-redesigned",
          "targets": ["TradeJS-Docs"]
        },
        {
          "name": "GHCR_TOKEN",
          "kind": "secret",
          "currentPurpose": "optional GHCR login override",
          "action": "keep-unless-built-in-repository-token-is-sufficient",
          "targets": ["TradeJS-Docs"]
        },
        {
          "name": "GITHUB_TOKEN",
          "kind": "built-in",
          "currentPurpose": "GHCR fallback authentication",
          "action": "do-not-migrate",
          "targets": []
        },
        {
          "name": "SSH_HOST",
          "kind": "secret",
          "currentPurpose": "documentation deployment host",
          "action": "keep-unless-docs-deployment-is-redesigned",
          "targets": ["TradeJS-Docs"]
        },
        {
          "name": "SSH_USER",
          "kind": "secret",
          "currentPurpose": "documentation deployment user",
          "action": "keep-unless-docs-deployment-is-redesigned",
          "targets": ["TradeJS-Docs"]
        },
        {
          "name": "SSH_KEY",
          "kind": "secret",
          "currentPurpose": "documentation deployment key",
          "action": "keep-and-rotate-on-independent-schedule",
          "targets": ["TradeJS-Docs"]
        }
      ]
    },
    {
      "repository": "TradeJS-Site",
      "credentials": [
        {
          "name": "GHCR_USERNAME",
          "kind": "secret",
          "currentPurpose": "optional GHCR login override",
          "action": "keep-unless-site-publishing-is-redesigned",
          "targets": ["TradeJS-Site"]
        },
        {
          "name": "GHCR_TOKEN",
          "kind": "secret",
          "currentPurpose": "optional GHCR login override",
          "action": "keep-unless-built-in-repository-token-is-sufficient",
          "targets": ["TradeJS-Site"]
        },
        {
          "name": "GITHUB_TOKEN",
          "kind": "built-in",
          "currentPurpose": "GHCR fallback authentication",
          "action": "do-not-migrate",
          "targets": []
        },
        {
          "name": "SSH_HOST",
          "kind": "secret",
          "currentPurpose": "site deployment host",
          "action": "keep-unless-site-deployment-is-redesigned",
          "targets": ["TradeJS-Site"]
        },
        {
          "name": "SSH_USER",
          "kind": "secret",
          "currentPurpose": "site deployment user",
          "action": "keep-unless-site-deployment-is-redesigned",
          "targets": ["TradeJS-Site"]
        },
        {
          "name": "SSH_KEY",
          "kind": "secret",
          "currentPurpose": "site deployment key",
          "action": "keep-and-rotate-on-independent-schedule",
          "targets": ["TradeJS-Site"]
        }
      ]
    }
  ],
  "futureCredentials": [
    {
      "repository": "TradeJS-Project",
      "name": "NPM_READ_TOKEN",
      "kind": "secret",
      "when": "private strategy packages are introduced",
      "constraint": "Read-only package access; never reuse a publishing token."
    },
    {
      "repository": "TradeJS-Project",
      "name": "DEPLOY_DISPATCH_CREDENTIAL",
      "kind": "secret-or-github-app",
      "when": "Project images dispatch a TradeJS-Deploy rollout"
    },
    {
      "repository": "TradeJS-Deploy",
      "name": "GHCR_PULL_TOKEN",
      "kind": "secret",
      "when": "TradeJS-Project images become private",
      "constraint": "Read-only package pull access."
    },
    {
      "repository": "TradeJS-Deploy",
      "name": "PG_PASSWORD",
      "kind": "secret",
      "when": "the hardcoded production database password is removed",
      "constraint": "Create a new value, rotate the database credential, and never copy the current literal into GitHub."
    }
  ],
  "inlineEnvironmentVariables": [
    {
      "sourceRepository": "TradeJS-Deploy",
      "sourcePath": ".github/workflows/deploy.yml",
      "targetOwner": "TradeJS-Project",
      "names": [
        "RUNTIME_SIGNAL_RETENTION_DAYS",
        "BACKTEST_MAX_PARALLEL",
        "KLINE_CONCURRENCY_LIMIT",
        "SIGNALS_PARALLEL",
        "SIGNALS_KLINE_WS_ENABLED",
        "SIGNALS_KLINE_WS_WAIT_MS",
        "DERIVATIVES_CONTEXT_ENABLED",
        "DERIVATIVES_CONTEXT_INTERVALS",
        "DERIVATIVES_CONTEXT_LOOKBACK_HOURS",
        "DERIVATIVES_CONTEXT_TARGET_ENABLED",
        "DERIVATIVES_CONTEXT_EXTRA_REFERENCE_SYMBOLS",
        "DERIVATIVES_CONTEXT_BACKFILL_BATCH_DAYS",
        "DERIVATIVES_CONTEXT_BACKFILL_REQUEST_DELAY_MS",
        "DERIVATIVES_CONTEXT_BACKFILL_SYMBOL_BATCH_SIZE"
      ],
      "action": "move-defaults-to-project-and-allow-deploy-overrides"
    },
    {
      "sourceRepository": "TradeJS-Deploy",
      "sourcePath": ".github/workflows/deploy.yml",
      "targetOwner": "TradeJS-Project",
      "names": ["AGENT_GITHUB_REPOSITORY", "AGENT_GITHUB_BASE_BRANCH"],
      "action": "replace-with-versioned-strategy-repository-mapping"
    },
    {
      "sourceRepository": "TradeJS-Deploy",
      "sourcePath": ".github/workflows/deploy.yml",
      "targetOwner": "TradeJS-Project",
      "names": ["PUPPETEER_SKIP_DOWNLOAD", "PUPPETEER_EXECUTABLE_PATH"],
      "action": "move-to-project-image-defaults"
    },
    {
      "sourceRepository": "TradeJS-Deploy",
      "sourcePath": ".github/workflows/deploy.yml",
      "targetOwner": "TradeJS-Deploy",
      "names": [
        "NODE_ENV",
        "APP_URL",
        "NEXTAUTH_URL",
        "SIGNALS_DAEMON_HEAP_MB",
        "SERVER_HEALTH_HEAP_MB",
        "SIGNALS_SUMMARY_HEAP_MB",
        "RUNTIME_PARITY_HEAP_MB",
        "DERIVATIVES_INGEST_HEAP_MB",
        "CONTINUITY_HEAP_MB",
        "APP_MEMORY_LIMIT",
        "AGENT_MEMORY_LIMIT",
        "SITE_MEMORY_LIMIT",
        "DOCS_MEMORY_LIMIT",
        "TIMESCALE_MEMORY_LIMIT",
        "REDIS_MEMORY_LIMIT",
        "ML_INFER_MEMORY_LIMIT",
        "NGINX_MEMORY_LIMIT",
        "CERTBOT_MEMORY_LIMIT",
        "RESEARCH_AUTO_PARENT_HEAP_MB",
        "RESEARCH_AUTO_BACKTEST_PARENT_HEAP_MB",
        "RESEARCH_AUTO_AI_TRAIN_PARENT_HEAP_MB",
        "RESEARCH_AUTO_AGENT_PARENT_HEAP_MB",
        "BACKTEST_PARENT_HEAP_MB",
        "BACKTEST_WORKER_HEAP_MB",
        "MARKET_WS_PORT",
        "REDIS_HOST",
        "REDIS_PORT",
        "ML_GRPC_ADDRESS",
        "PG_HOST",
        "PG_PORT",
        "PG_USER",
        "PG_DATABASE"
      ],
      "action": "move-from-inline-workflow-text-to-production-environment-variables"
    },
    {
      "sourceRepository": "TradeJS-Deploy",
      "sourcePath": ".github/workflows/deploy.yml",
      "targetOwner": "TradeJS-Deploy",
      "names": ["PG_PASSWORD"],
      "action": "replace-hardcoded-value-with-production-environment-secret-and-rotate"
    }
  ],
  "nonSecretOwnership": [
    {
      "owner": "TradeJS-Project",
      "categories": [
        "strategy composition",
        "signals and backtest defaults",
        "research defaults",
        "research agent repository mapping",
        "application feature defaults"
      ]
    },
    {
      "owner": "TradeJS-Deploy",
      "categories": [
        "production URLs",
        "service addresses and ports",
        "container memory limits",
        "server paths and volumes",
        "environment-specific overrides"
      ]
    }
  ]
}
