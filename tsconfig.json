{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./apps/app/src/*"
      ],
      "@tradejs/core/*": [
        "./packages/core/src/*"
      ],
      "@tradejs/connectors": [
        "./packages/connectors/src/index"
      ],
      "@tradejs/connectors/*": [
        "./packages/connectors/src/*"
      ],
      "@tradejs/sdk": [
        "./packages/sdk/src/index"
      ],
      "@tradejs/sdk/*": [
        "./packages/sdk/src/*"
      ],
      "@app/*": [
        "./apps/app/src/app/*"
      ],
      "@actions/*": [
        "./apps/app/src/app/actions/*"
      ],
      "@store": [
        "./apps/app/src/app/store/index"
      ],
      "@constants": [
        "./packages/core/src/constants/index"
      ],
      "@types": [
        "./packages/core/src/types/index"
      ],
      "@shared/*": [
        "./apps/app/src/app/components/Shared/*"
      ],
      "@utils/*": [
        "./packages/core/src/utils/*"
      ],
      "@UI": [
        "./apps/app/src/app/components/UI/index"
      ],
      "@components/*": [
        "./apps/app/src/app/components/*"
      ]
    },
    "target": "ES2017"
  },
  "ts-node": {
    // these options are overrides used only by ts-node
    // same as the --compilerOptions flag and the TS_NODE_COMPILER_OPTIONS environment variable
    "compilerOptions": {
      "module": "commonjs"
    },
    "require": [
      "tsconfig-paths/register"
    ]
  },
  "include": [
    "apps/app/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "apps/app/.next/types/**/*.ts",
    "apps/app/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
