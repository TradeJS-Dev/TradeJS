{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["jest", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/app/src/*"],
      "@tradejs/connectors": ["./packages/connectors/src/index"],
      "@tradejs/core/api": ["./packages/core/src/api"],
      "@tradejs/core/async": ["./packages/core/src/async"],
      "@tradejs/core/backtest": ["./packages/core/src/backtest"],
      "@tradejs/core/cli": ["./packages/core/src/cli"],
      "@tradejs/core/config": ["./packages/core/src/config"],
      "@tradejs/core/connectors": ["./packages/core/src/connectors"],
      "@tradejs/core/constants": ["./packages/core/src/constants"],
      "@tradejs/core/data": ["./packages/core/src/data"],
      "@tradejs/core/figures": ["./packages/core/src/figures"],
      "@tradejs/core/indicators": ["./packages/core/src/indicators"],
      "@tradejs/core/json": ["./packages/core/src/json"],
      "@tradejs/core/math": ["./packages/core/src/math"],
      "@tradejs/core/pine": ["./packages/core/src/pine"],
      "@tradejs/core/strategies": ["./packages/core/src/strategies"],
      "@tradejs/core/tickers": ["./packages/core/src/tickers"],
      "@tradejs/core/time": ["./packages/core/src/time"],
      "@tradejs/infra": ["./packages/infra/src/index"],
      "@tradejs/base": ["./packages/base/src/index"],
      "@tradejs/strategies": ["./packages/strategies/src/index"],
      "@tradejs/indicators": ["./packages/indicators/src/index"],
      "@tradejs/types": ["./packages/types/src/index"],
      "@tradejs/types/*": ["./packages/types/src/*"],
      "@app/*": ["./apps/app/src/app/*"],
      "@actions/*": ["./apps/app/src/app/actions/*"],
      "@store": ["./apps/app/src/app/store/index"],
      "@constants": ["./packages/core/src/constants/index"],
      "@shared/*": ["./apps/app/src/app/components/Shared/*"],
      "@utils/*": ["./packages/core/src/utils/*"],
      "@UI": ["./apps/app/src/app/components/UI/index"],
      "@components/*": ["./apps/app/src/app/components/*"]
    },
    "target": "ES2017"
  },
  "ts-node": {
    // these options are overrides used only by ts-node
    // same as the --compilerOptions flag and the TS_NODE_COMPILER_OPTIONS environment variable
    "compilerOptions": {
      "module": "commonjs"
    },
    "require": ["tsconfig-paths/register"]
  },
  "include": [
    "apps/app/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "apps/app/.next/types/**/*.ts",
    "apps/app/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/site/**", "**/dist/**"]
}
