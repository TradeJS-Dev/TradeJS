30 22 * * * cd /app && PROJECT_CWD=/app DOTENV_CONFIG_PATH=/app/.env NODE_OPTIONS="--max-old-space-size=${DERIVATIVES_INGEST_HEAP_MB:-1536}" bash ./bin/run-cli-runtime.sh derivatives:ingest:coinalyze:all --days 2 >> /var/log/cron.derivatives.coinalyze.all.log 2>&1
0 23 * * * cd /app && PROJECT_CWD=/app DOTENV_CONFIG_PATH=/app/.env NODE_OPTIONS="--max-old-space-size=${CONTINUITY_HEAP_MB:-1536}" bash ./bin/run-cli-runtime.sh continuity >> /var/log/cron.continuity.log 2>&1
